<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Catalogue Directory.Packages.props = versions cibles (EF 8.0.11, MassTransit 8.3.6, MediatR 12.4.1).
         CPM full (ManagePackageVersionsCentrally=true) reporté : retirer Version= des .csproj progressivement. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>Kyntus</Company>
    <Product>Kyntus Platform</Product>
  </PropertyGroup>
</Project>
