# Copier ce fichier vers .env à la racine du dépôt (jamais committer .env).
# Docker Compose charge automatiquement .env depuis ce répertoire.
#
# Développement local .NET (sans Docker) — variables d'environnement équivalentes :
#   set ConnectionStrings__DefaultConnection=...
#   set JwtSettings__Secret=...
# (PowerShell : $env:ConnectionStrings__DefaultConnection="...")

# ─── JWT (tous les backends Kyntus) ───────────────────────────────────────────
KYNTUS_JWT_SECRET=change-me-minimum-32-caracteres-secrets-jwt
KYNTUS_JWT_ISSUER=AuthService
KYNTUS_JWT_AUDIENCE=AuthServiceClient

# ─── Postgres (stack docker-compose racine) ───────────────────────────────────
KYNTUS_POSTGRES_USER=postgres
KYNTUS_POSTGRES_PASSWORD=change-me-postgres-root

# ─── pgAdmin ───────────────────────────────────────────────────────────────────
KYNTUS_PGADMIN_EMAIL=admin@kyntus.ma
KYNTUS_PGADMIN_PASSWORD=change-me-pgadmin

# ─── RabbitMQ ──────────────────────────────────────────────────────────────────
KYNTUS_RABBITMQ_USER=guest
KYNTUS_RABBITMQ_PASSWORD=change-me-rabbitmq
KYNTUS_RABBITMQ_ERLANG_COOKIE=change-me-erlang-cookie

# ─── Mots de passe utilisateurs PostgreSQL (init DB) ─────────────────────────
# Doivent correspondre aux mots de passe dans les KYNTUS_CONN_* ci-dessous.
KYNTUS_DB_PASSWORD_KYNTUS=change-me-planning-db
KYNTUS_DB_PASSWORD_AUTH=change-me-auth-db
KYNTUS_DB_PASSWORD_FORMATION=change-me-formation-db
KYNTUS_DB_PASSWORD_DOCUMENTATION=change-me-documentation-db
KYNTUS_DB_PASSWORD_CONGE=change-me-conge-db
KYNTUS_DB_PASSWORD_PRIME=change-me-prime-db
KYNTUS_DB_PASSWORD_PARRAINAGE=change-me-parrainage-db
KYNTUS_DB_PASSWORD_DIRECTORY=change-me-directory-db

# ─── Chaînes de connexion (services Docker) ───────────────────────────────────
# Maximum Pool Size calibré pour ≥300 users (somme pools ≪ max_connections=250).
KYNTUS_CONN_AUTH=Host=postgres;Port=5432;Database=auth_db;Username=auth_user;Password=change-me-auth-db;Maximum Pool Size=30;Timeout=15
KYNTUS_CONN_PLANNING=Host=postgres;Port=5432;Database=kyntus_db;Username=kyntus_user;Password=change-me-planning-db;Maximum Pool Size=40;Timeout=15
KYNTUS_CONN_FORMATION=Host=postgres;Port=5432;Database=formation_db;Username=formation_user;Password=change-me-formation-db;Maximum Pool Size=25;Timeout=15
KYNTUS_CONN_DOCUMENTATION=Host=postgres;Port=5432;Database=documentation_db;Username=documentation_user;Password=change-me-documentation-db;Maximum Pool Size=25;Timeout=15
KYNTUS_DOCUMENTATION_DB_PASSWORD=change-me-documentation-db
KYNTUS_CONN_CONGE=Host=postgres;Port=5432;Database=conge_db;Username=postgres;Password=change-me-conge-db;Maximum Pool Size=25;Timeout=15
KYNTUS_CONN_PRIME=Host=postgres;Port=5432;Database=prime_db;Username=prime_user;Password=change-me-prime-db;Maximum Pool Size=35;Timeout=15
KYNTUS_CONN_PARRAINAGE=Host=postgres;Port=5432;Database=parrainage_db;Username=parrainage_user;Password=change-me-parrainage-db;Maximum Pool Size=20;Timeout=15
KYNTUS_CONN_DIRECTORY=Host=postgres;Port=5432;Database=employee_directory_db;Username=directory_user;Password=change-me-directory-db;Maximum Pool Size=40;Timeout=15

# ─── Redis (cache L2 partagé) ─────────────────────────────────────────────────
# Docker Compose : redis:6379 | Local hors Docker : localhost:6379
KYNTUS_REDIS_CONNECTION=redis:6379
# Caching__InstanceName=kyntus:

# ─── AuthService seul (AuthService/AuthService/docker-compose.yml) ───────────
KYNTUS_AUTH_STANDALONE_POSTGRES_PASSWORD=change-me-auth-standalone
KYNTUS_AUTH_STANDALONE_DB_CONNECTION=Host=postgres;Port=5432;Database=AuthServiceDb;Username=postgres;Password=change-me-auth-standalone

# Les mots de passe des utilisateurs dans init/docker-entrypoint-initdb.d/
# doivent correspondre aux KYNTUS_DB_PASSWORD_* et aux KYNTUS_CONN_* ci-dessus.

# ─── Clé service-to-service (Planning → Auth provisioning / reset) ───────────
# Obligatoire en prod : sans cette clé, register-from-planning et reset admin sont refusés.
KYNTUS_INTERNAL_SERVICE_API_KEY=change-me-internal-service-api-key-min-32-chars

# ─── Web Push VAPID (notifications bureau) ────────────────────────────────────
# Générer une paire (ne jamais committer la clé privée réelle) :
#   npx --yes web-push generate-vapid-keys
# Ou via le package .NET WebPush (VapidHelper.GenerateVapidKeys).
KYNTUS_VAPID_PUBLIC_KEY=
KYNTUS_VAPID_PRIVATE_KEY=
KYNTUS_VAPID_SUBJECT=mailto:admin@kyntus.ma

# ─── SMTP planning (compte serveur d'envoi — secrets, pas l'UI admin) ─────────
# HOST/PORT/USER/PASSWORD/ENABLE_SSL : connexion au fournisseur (Gmail, Outlook…).
# FROM : adresse « De : » par défaut si l'admin n'a pas saisi d'expéditeur
#        (Validation plannings → Email expéditeur). Host vide = aucun mail.
KYNTUS_SMTP_HOST=
KYNTUS_SMTP_PORT=587
KYNTUS_SMTP_USER=
KYNTUS_SMTP_PASSWORD=
KYNTUS_SMTP_FROM=
KYNTUS_SMTP_ENABLE_SSL=true

# ─── HTEL (Employee Directory — liaisons techniciens) ─────────────────────────
# Endpoint : https://htel-groupe.fr/api/v1/techniciens
# ApiKey optionnelle (header X-Api-Key si fournie) — comme b8781ae l’appel part sans clé.
HTEL_BASE_URL=https://htel-groupe.fr/
HTEL_TECHNICIENS_URL=https://htel-groupe.fr/api/v1/techniciens
HTEL_API_KEY=

# ─── Auth login seed (rôles + comptes de connexion locaux) ───────────────────
# Activer seulement en local. Un compte par rôle @kyntus.ma — mot de passe commun.
KYNTUS_DEMO_SEED_ENABLED=false
KYNTUS_DEMO_SEED_PASSWORD_EMPLOYEE=Azerty@2026
KYNTUS_DEMO_SEED_PASSWORD_RH=Azerty@2026
KYNTUS_DEMO_SEED_PASSWORD_MANAGER=Azerty@2026
KYNTUS_DEMO_SEED_PASSWORD_COACH=Azerty@2026
KYNTUS_DEMO_SEED_PASSWORD_RP=Azerty@2026
KYNTUS_DEMO_SEED_PASSWORD_ADMIN=Azerty@2026
KYNTUS_DEMO_SEED_PASSWORD_AUDIT=Azerty@2026
KYNTUS_DEMO_SEED_PASSWORD_FORMATION=Azerty@2026
KYNTUS_DEMO_SEED_PASSWORD_SUPERVISEUR=Azerty@2026
KYNTUS_DEMO_SEED_PASSWORD_QUALITICIEN=Azerty@2026

# ─── Qualité KCQ (picking audio optionnel) ─────────────────────────────────
# mysql = table audio_index (nécessite KYNTUS_KCQ_DB_HOST). Si l’hôte est vide, lecture locale du volume.
KYNTUS_KCQ_RECORDINGS_MODE=mysql
KYNTUS_KCQ_DB_HOST=
KYNTUS_KCQ_DB_PORT=3306
KYNTUS_KCQ_DB_NAME=enregistrement_audio
KYNTUS_KCQ_DB_USER=kpi
KYNTUS_KCQ_DB_PASSWORD=
KYNTUS_KCQ_PICKING_API_URL=
KYNTUS_KCQ_PICKING_API_KEY=
# Chemin hôte monté en lecture dans kcq-backend (/app/audio_mails)
# KYNTUS_KCQ_AUDIO_HOST_PATH=./QualiteService/audio_mails
# Dump Mongo (./backup_kcq_db, base KyntusCQ) : restauré une fois dans kcq-mongo si scores est vide.
# Les images OCI ./kcq_images ne sont pas utilisées au runtime (wrap QualiteService).
# DIRECTORY_SYNC_INTERVAL_MS=600000

# Données métier mock (sessions formation, réclamations démo, etc.) — laisser false pour data clean
KYNTUS_DEMO_ENRICHMENT=false
KYNTUS_FORMATION_DEMO_SEED=false
KYNTUS_PLANNING_DEMO_SEED=false
KYNTUS_CONGE_DEMO_SEED=false

# ─── Développement local hors Docker (exemples — adapter à votre machine) ─────
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=AuthServiceDb;Username=postgres;Password=
# JwtSettings__Secret=


# Première connexion Pilote / Qualiticien. Ne jamais versionner la valeur réelle.
KYNTUS_FIRST_LOGIN_ENABLED=false
KYNTUS_FIRST_LOGIN_COMMON_PASSWORD=
KYNTUS_FIRST_LOGIN_TEMPORARY_HOURS=72
